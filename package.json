{
    "name":  "3d-low-poly-village-portfolio",
    "version":  "1.0.0",
    "description":  "Interactive 3D Low-Poly Village Portfolio built with Three.js \u0026 Tailwind CSS by Md Mujahidul Islam",
    "main":  "index.html",
    "scripts":  {
                    "dev":  "npx -y serve . -l 3000",
                    "start":  "npx -y serve . -l 3000",
                    "build":  "node -e \"const fs=require(\u0027fs\u0027); [\u0027public\u0027, \u0027dist\u0027].forEach(d =\u003e { fs.mkdirSync(d, {recursive:true}); fs.copyFileSync(\u0027index.html\u0027, d + \u0027/index.html\u0027); if(fs.existsSync(\u0027robots.txt\u0027)) fs.copyFileSync(\u0027robots.txt\u0027, d + \u0027/robots.txt\u0027); if(fs.existsSync(\u0027sitemap.xml\u0027)) fs.copyFileSync(\u0027sitemap.xml\u0027, d + \u0027/sitemap.xml\u0027); }); console.log(\u0027Build completed: public \u0026 dist directories ready.\u0027);\""
                },
    "keywords":  [
                     "threejs",
                     "threejs-portfolio",
                     "3d-portfolio",
                     "low-poly",
                     "webgl",
                     "packaging-designer",
                     "creative-developer",
                     "tailwind-css",
                     "interactive-portfolio",
                     "javascript"
                 ],
